# Server port
PORT=5000

# MongoDB connection string (MongoDB Atlas free tier)
# Create a cluster at https://cloud.mongodb.com and copy the connection string.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/textile-marketplace

# JWT secret - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed frontend origin
CLIENT_ORIGIN=http://localhost:5173

# --- Optional: Hugging Face LLM for the AI assistant ---
# Get a free token: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
